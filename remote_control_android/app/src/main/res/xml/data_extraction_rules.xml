<?xml version="1.0" encoding="utf-8"?>
<!--
    Never back up or transfer the device identity: the Ed25519 private key is
    what the relay has bound to this phone's device_id, and restoring it onto
    another device would hand out a second identity for the same pair.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
