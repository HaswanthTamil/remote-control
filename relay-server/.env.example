# PAIR_TOKEN is REQUIRED. Set it at deploy time via the platform's env vars,
# NOT in the image (relay-server/.env is excluded from Docker builds so the
# secret is never published). Override locally with: docker run -e PAIR_TOKEN=...
PAIR_TOKEN=generate-a-long-random-string
PORT=3000

# Device keystore backend.
#   KEYSTORE=file    -> devices.json (default; needs a persistent disk/volume)
#   KEYSTORE=sqlite  -> Turso/libSQL (required on Vercel: read-only filesystem)
#
# KEYSTORE is auto-selected: sqlite if TURSO_URL is set, otherwise file.
# So on Vercel you only need TURSO_URL + TURSO_AUTH_TOKEN.
#
# For KEYSTORE=sqlite on Vercel:
#   1. Create a Turso database: https://docs.turso.tech -> "Turso SQLite".
#   2. The schema (relay-server/schema.sql) is applied automatically at
#      startup; you can also run it manually: turso db shell <db> < schema.sql
#   3. Set env vars on the platform:
#        TURSO_URL          = https://<db>-<org>.turso.io
#        TURSO_AUTH_TOKEN   = your readonly/read-write token
#   Registered devices survive redeploys because the keystore is in the DB.
# TURSO_URL=https://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=...
# TURSO_URL can also be a local file path (file:/tmp/devices.db) for testing.

# Heartbeat / auth tuning (milliseconds)
# HEARTBEAT_INTERVAL=20000
# AUTH_TIMEOUT_MS=10000
# KEYS_FILE=/absolute/path/to/devices.json